# ==============================================================================
# LostLink Full-Stack Environment Configuration Reference
# Do NOT commit actual secrets or production .env files to Git.
# ==============================================================================

# --- BACKEND (Render / Spring Boot) ---
SPRING_PROFILES_ACTIVE=prod
PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
JWT_SECRET=your_production_secret_key_minimum_32_characters_random_string!
FRONTEND_URL=https://lostlink.vercel.app
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
SPRING_H2_CONSOLE_ENABLED=false

# --- FRONTEND (Vercel / React) ---
VITE_API_BASE_URL=https://lostlink-backend.onrender.com
VITE_WS_URL=https://lostlink-backend.onrender.com/ws
